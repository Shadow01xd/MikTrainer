<Project Sdk="Microsoft.NET.Sdk">

  <!-- Interfaz de escritorio (WinForms). Program.cs es la raíz de composición: aquí se conectan Core e Infrastructure. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Para leer la memoria de juegos de 64 bits, MiTrainer también tiene que ser de 64 bits -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MiTrainer</AssemblyName>
    <RootNamespace>MiTrainer.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiTrainer.Core\MiTrainer.Core.csproj" />
    <ProjectReference Include="..\MiTrainer.Infrastructure\MiTrainer.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MiTrainer.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="perfiles\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
