    <ProjectReference Include="..\..\samples\JuegoPrueba\JuegoPrueba.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\MiTrainer.App\perfiles\ejemplo.json" Link="Datos\ejemplo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
